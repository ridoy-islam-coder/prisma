// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String 
  email     String   @unique
  password  String 
  watchlist Movie[]  @relation("UserWatchlist")
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("users")
}

model Movie {
  id             String   @id @default(uuid())
  title          String
  director       String
  rating         String?
  genre          String?
  watchlistUsers User[]   @relation("UserWatchlist")
  reviews        Review[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  content   String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movie     Movie    @relation(fields: [movieId], references: [id])
  movieId   String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
}